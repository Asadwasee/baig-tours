{
  "info": {
    "name": "Baig Tours - Booking, Customer & Admin API",
    "description": "Collection for auth, packages, customers, bookings, blogs, and dashboard endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "packageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "blogId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"admin@baigtours.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "} else if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}" 
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@baigtours.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Packages",
      "item": [
        {
          "name": "Get All Packages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/packages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "packages"]
            }
          }
        },
        {
          "name": "Create Package",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json._id) {",
                  "  pm.collectionVariables.set('packageId', json._id);",
                  "}" 
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hunza Valley Adventure\",\n  \"category\": \"Family\",\n  \"destination\": \"Hunza\",\n  \"price\": 85000,\n  \"discountPrice\": 75000,\n  \"duration\": \"5 Days / 4 Nights\",\n  \"availableSeats\": 20,\n  \"departureDate\": \"2026-08-10T00:00:00.000Z\",\n  \"returnDate\": \"2026-08-14T00:00:00.000Z\",\n  \"pickupLocation\": \"Islamabad\",\n  \"hotelInfo\": \"4 Star Hotel\",\n  \"transportDetails\": \"Air conditioned coach\",\n  \"mealsIncluded\": true,\n  \"description\": \"A beautiful Hunza trip for families\",\n  \"highlights\": [\"Lake views\", \"Local culture\"],\n  \"includedServices\": [\"Hotel\", \"Breakfast\"],\n  \"excludedServices\": [\"Flight\"],\n  \"itinerary\": [\n    {\n      \"day\": 1,\n      \"title\": \"Arrival\",\n      \"description\": \"Arrival in Islamabad\"\n    }\n  ],\n  \"faqs\": [\n    {\n      \"question\": \"Is transport included?\",\n      \"answer\": \"Yes\"\n    }\n  ],\n  \"images\": [\n    \"https://example.com/image1.jpg\"\n  ],\n  \"isFeatured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/packages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "packages"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json._id) {",
                  "  pm.collectionVariables.set('customerId', json._id);",
                  "}" 
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Khan\",\n  \"email\": \"ahmed@example.com\",\n  \"phone\": \"+923001234567\",\n  \"nationality\": \"Pakistani\",\n  \"country\": \"Pakistan\",\n  \"passportNumber\": \"PK123456\",\n  \"address\": \"Islamabad\",\n  \"notes\": \"First time traveler\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json._id) {",
                  "  pm.collectionVariables.set('bookingId', json._id);",
                  "}" 
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"{{customerId}}\",\n  \"package\": \"{{packageId}}\",\n  \"travelDate\": \"2026-08-10T00:00:00.000Z\",\n  \"adults\": 2,\n  \"children\": 1,\n  \"totalAmount\": 160000,\n  \"currency\": \"PKR\",\n  \"status\": \"pending\",\n  \"paymentStatus\": \"pending\",\n  \"specialRequests\": \"Window seats\",\n  \"source\": \"web\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "Get All Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/blogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs"]
            }
          }
        },
        {
          "name": "Create Blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json._id) {",
                  "  pm.collectionVariables.set('blogId', json._id);",
                  "} else if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('blogId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Discovering Fairy Meadows\",\n  \"content\": \"Fairy Meadows is a beautiful grassland near Nanga Parbat.\",\n  \"category\": \"Adventure\",\n  \"author\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs"]
            }
          }
        },
        {
          "name": "Get Single Blog",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "{{blogId}}"]
            }
          }
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "{{blogId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "summary"]
            }
          }
        }
      ]
    }
  ]
}